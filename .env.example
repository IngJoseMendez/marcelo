# ─────────────────────────────────────────────────────────────
#  Mi Segundo Cerebro — configuración
#  Copia este archivo a .env y llena los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos ------------------------------------------------
DATABASE_URL=postgres://asistente:cambiame@localhost:5433/asistente
POSTGRES_PASSWORD=cambiame

# Zona horaria de TODO el sistema. No cambiar sin leer el spec.
ZONA_HORARIA=America/Bogota

# Cerebro (Groq) -----------------------------------------------
# console.groq.com  →  activa Zero Data Retention en Data Controls
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Verifica los identificadores contra el catálogo vigente de Groq.
GROQ_MODELO_CLASIFICADOR=
GROQ_MODELO_EXTRACTOR=

# Google (Gmail + Calendar) ------------------------------------
# console.cloud.google.com → OAuth en modo Testing (sin verificación)
# Alcances: gmail.readonly, calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Tópico de Pub/Sub para el push de Gmail
GMAIL_TOPICO_PUBSUB=

# Microsoft (Outlook) ------------------------------------------
# entra.microsoft.com → registro de app
# Permisos delegados: Mail.Read, offline_access
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REFRESH_TOKEN=

# La app ------------------------------------------------------
# Token que usa el BFF de Next.js para hablarle a este servicio.
# Genéralo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El mismo valor va en web/.env.local como API_TOKEN.
API_TOKEN=

# Ventana de trabajo: fuera de ella el tiempo libre no cuenta como
# hueco. Sin esto, "tienes 9 horas libres" incluiría la madrugada.
JORNADA_DESDE=07:00
JORNADA_HASTA=22:00

# Comportamiento -----------------------------------------------
# Arranca SIEMPRE en true. No se pasa a false hasta que el modo
# sombra reporte >=95% de aciertos durante 5 días seguidos.
MODO_SOMBRA=true

PUERTO=3000
NIVEL_LOG=info
