# ─────────────────────────────────────────────────────────────
#  La app — configuración
#  Copia este archivo a .env.local (o pégalo en Vercel).
#  NINGUNA de estas variables llega al navegador: las route
#  handlers hacen de BFF y el token se queda en el servidor.
# ─────────────────────────────────────────────────────────────

# Dónde vive la asistente. En local, el Fastify de la laptop.
# En producción, la URL del Cloudflare Tunnel.
API_BASE=http://localhost:3000

# El mismo valor que API_TOKEN en el .env del backend.
API_TOKEN=

# Código para entrar a la app. Mientras no exista el bot de
# Telegram que lo mande, es un código fijo que sólo tú sabes.
CODIGO_ACCESO=

# Firma de la cookie de sesión. Genéralo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_SESION=
